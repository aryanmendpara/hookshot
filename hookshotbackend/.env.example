# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/hookshot
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hookshot?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/hookshot

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Port the API listens on.
PORT=5001

# Comma-separated list of allowed browser origins (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# --- Rate limits (optional; these are the defaults if unset) ---
# Failed-login attempts allowed per minute, keyed on IP + email.
LOGIN_RATE_LIMIT=5

# Events allowed per minute, keyed on user id.
# Raise this for the test server: the 50-cap pagination test needs 55 inserts
# from one user inside a few milliseconds, which 20/min correctly refuses.
EVENT_RATE_LIMIT=20

# --- Cache (optional; this is the default if unset) ---
# How long a user's active-endpoint list stays cached, in ms. A backstop only:
# every endpoint create/update/delete invalidates immediately, so this only
# bounds how long a change made OUTSIDE this API keeps serving stale data.
ENDPOINT_CACHE_TTL_MS=300000